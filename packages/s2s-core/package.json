{
	"name": "@spotq/s2s-core",
	"version": "1.0.0",
	"description": "Stateless Service-to-Service (S2S) authentication middleware and token issuer for SpotQ microservices",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "restricted"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ACE-Program-Brototype/spotq-common.git",
		"directory": "packages/s2s-core"
	},
	"scripts": {
		"clean": "rm -rf dist",
		"prebuild": "pnpm run clean",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "jest",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"jsonwebtoken": "^9.0.2"
	},
	"peerDependencies": {
		"express": "^4.18.0 || ^5.0.0"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^20.14.0",
		"express": "^4.19.2",
		"jest": "^30.5.2",
		"ts-jest": "^29.4.14",
		"typescript": "^5.4.5"
	},
	"keywords": [
		"spotq",
		"s2s",
		"authentication",
		"jwt",
		"rs256",
		"middleware",
		"microservices"
	],
	"author": "SpotQ Team",
	"license": "UNLICENSED"
}
